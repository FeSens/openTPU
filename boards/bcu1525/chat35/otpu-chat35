#!/bin/bash
# otpu-chat35: chat with Qwen3.6-35B-A3B on one BCU1525 (the bcu1525-wg:bhw16 image) from the cached card image (ENTRY,
# packed on a host with the RAM for it: c35.sh build). Brings the card up under the guard (wg_bringup up: the four
# DIMMs, the accelerator; RUN held), chats (opentpu.host.chat through cardimg/chat35.py: the 35B resident, its whole
# 262,144-token context, fp4 experts + int8 head, the generate loop on the card), and puts the card back in SAFE when
# the chat ends. The programs come from the chat's own program cache (cardimg/qprog35: warm35.py fills every bucket's
# between chats). The image: the cache's entry (CHAT35_IMG, default $BCU_DATA/img35) as a raw image on the SSD
# (CHAT35_RAW, default cardimg/raw35; chat35.py expands it once), mapped, its pages read into the page cache while the
# card comes up. A prompt part of 64 tokens or more goes layer by layer, 2 rows a run (CHAT35_LM, 0: token by token;
# the LM head skipped for its rows: ~23 against 31 ms a token).
# Options go to the chat (otpu-chat35 --help: its own):
#   otpu-chat35                      # the full-screen chat
#   otpu-chat35 --prompt "Hi"        # one question, plain output
set -u
# This host's cards and directories: the shell file BCU_ENV (default ~/.config/otpu/bcu.env) sets, for each card N
# (0, 1), BCU_CARDN_SERIAL (its JTAG serial), BCU_CARDN_BDF (its PCI function, 0000:BB:DD.F) and, optionally,
# BCU_CARDN_NAME (a short name for the messages, default cardN), BCU_BUILD (the build directory, default
# ~/otpu-build), BCU_DATA (the images' and KV stores' disk, default $BCU_BUILD/data) and BCU_PY (the python3 with
# the host's packages, default the PATH's); BCU_CARD the card of the single-card wrappers (default 0: its XDMA device is found by
# its PCI function; BCU_DEV names it instead).
[ -f "${BCU_ENV:=$HOME/.config/otpu/bcu.env}" ] && . "$BCU_ENV"
BB=${BCU_BUILD:-$HOME/otpu-build}; DATA=${BCU_DATA:-$BB/data}; PY=${BCU_PY:-$(command -v python3)}
card() {        # card N: S, BDF and NAME of card N, from BCU_CARDN_*
  local s=BCU_CARD${1}_SERIAL b=BCU_CARD${1}_BDF n=BCU_CARD${1}_NAME
  S=${!s:-}; BDF=${!b:-}; NAME=${!n:-card$1}
  [ -n "$S" ] && [ -n "$BDF" ] || { echo "$(basename "$0"): $s and $b are not set (BCU_ENV: $BCU_ENV)"; exit 2; }
}
card "${BCU_CARD:-0}"
B=$BB/cardimg
T=$B/tree-TREE
ENTRY=KEY
# "$PY" -c "$SETSID" CMD ARGS: CMD in a session of its own (no fork: $! stays its PID), out of the terminal's process
# group: neither its Ctrl-C nor its hangup reaches it
SETSID='import os, sys
try:
    os.setsid()
except OSError:                 # (a process group leader already: not in the foreground group)
    pass
os.execv(sys.argv[1], sys.argv[1:])'
cd "$T" || exit 2
# the card's XDMA device: the one at its PCI function (BCU_DEV instead, when set: it must be that card's)
u=$(ls /sys/bus/pci/devices/$BDF/xdma/ 2>/dev/null | grep "_user$" | head -1)
case " $* " in *" -h "*|*" --help "*) : ;; *)
  [ -n "$u" ] || { echo "otpu-chat35: no XDMA device on $NAME ($BDF): is the bcu1525-wg:bhw16 image loaded?"; exit 1; }
  [ -z "${BCU_DEV:-}" ] || [ "/dev/${u%_user}" = "$BCU_DEV" ] || { echo "otpu-chat35: $NAME is /dev/${u%_user}, not BCU_DEV=$BCU_DEV"; exit 1; } ;;
esac
DEV=/dev/${u%_user}
# the image cache key covers every OTPU_* variable but the runtime ones (OTPU_DEV is one): exactly the entry's
for v in $(env | grep -o '^OTPU_[A-Z0-9_]*'); do unset "$v"; done
export CARD_NAME=$NAME PYTHONPATH=. OTPU_TARGET=bcu1525-wg:bhw16 OTPU_DEV=$DEV OTPU_IMG_CACHE=${CHAT35_IMG:-$DATA/img35} OTPU_IMG_CACHE_GB=100 \
  OTPU_PROG_CACHE=$B/qprog35 OTPU_PROG_CACHE_GB=8 CHAT35_ENTRY=$ENTRY CHAT35_RAW=${CHAT35_RAW:-$B/raw35} \
  CHAT35_LM=${CHAT35_LM:-2}
case " $* " in *" -h "*|*" --help "*) exec "$PY" "$B/chat35.py" --help ;; esac
jobs=$(pgrep -af "[w]g_bringup|[t]ools\.qual|[b]oard_perf|[x]2_card|[c]hat35\.py|[w]arm35\.py|[s]erve35\.py")
[ -z "$jobs" ] || { echo "otpu-chat35: a card job is running:"; echo "$jobs"; exit 1; }
out=$B/runs/chat35-$(date +%m%d-%H%M%S)
mkdir -p "$out"
"$PY" - <<'PYEOF' || exit 1
import os
from opentpu.host.board import XdmaTransport
from opentpu.host import gov as G
g = G.Gov(XdmaTransport(os.environ["OTPU_DEV"], dma=False))
if not g.present():
    raise SystemExit(f"otpu-chat35: no governor on {os.environ['CARD_NAME']} (is the bcu1525-wg:bhw16 image loaded?)")
print(f"otpu-chat35: {os.environ['CARD_NAME']} die {g.status()['temp_c']:.1f} C")
PYEOF
# the raw image's data into the page cache meanwhile (its holes are zeros: not read)
( exec nice -n 10 "$PY" - "$CHAT35_RAW/$ENTRY.raw" <<'PYEOF'
import os, sys
try:
    fd = os.open(sys.argv[1], os.O_RDONLY)
except OSError:
    sys.exit(0)
end, pos, buf = os.fstat(fd).st_size, 0, memoryview(bytearray(16 << 20))
while pos < end:
    try:
        a = os.lseek(fd, pos, os.SEEK_DATA)
    except OSError:
        break
    b = os.lseek(fd, a, os.SEEK_HOLE)
    while a < b:
        n = os.preadv(fd, [buf[:min(len(buf), b - a)]], a)
        if n <= 0:
            break
        a += n
    pos = b
PYEOF
) > /dev/null 2>&1 &
echo "otpu-chat35: bringing $NAME up on $DEV (about a minute; log $out/up.log)"
# the bring-up in a session of its own: Ctrl-C in the chat must not end the hold under it, nor the terminal's hangup
# (ignoring SIGINT is not enough: wg_bringup installs its own handler); it ends on bye's TERM, after the chat
( exec "$PY" -c "$SETSID" "$PY" -u boards/bcu1525/scripts/wg_bringup.py up --out "$out" --serial $S --dev $DEV \
    --no-jtag --no-trips --mem none --no-selftest --hold 240 ) > "$out/up.log" 2>&1 &
up=$!
safe_line() {    # once the bring-up has exited: the governor's state after its SAFE (wg.json's status_safe)
  if "$PY" - "$out/wg.json" <<'PYEOF'
import json, sys
try:
    s = json.load(open(sys.argv[1])).get("status_safe") or {}
except (OSError, ValueError):
    s = {}
sys.exit(0 if s and not s.get("run") and not s.get("acc_on") else 1)
PYEOF
  then echo "otpu-chat35: card back in SAFE ($out)"
  else echo "otpu-chat35: the bring-up has ended, but $out/wg.json does not say SAFE: check the card (otpu-smi)"
  fi
}
bye() { kill -TERM "$up" 2>/dev/null; wait "$up" 2>/dev/null; safe_line; }
trap bye EXIT
trap 'exit 129' HUP             # (a hangup: after the chat has ended, as Ctrl-C's exit)
until [ -f "$out/HOLDING" ]; do
  if ! kill -0 "$up" 2>/dev/null; then echo "otpu-chat35: the bring-up failed:"; tail -15 "$out/up.log"; exit 1; fi
  sleep 1
done
echo "otpu-chat35: card up; loading the 35B (its 19 GB image to the card)"
"$PY" "$B/chat35.py" "$@"
