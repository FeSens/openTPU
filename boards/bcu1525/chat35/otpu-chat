#!/bin/bash
# otpu-chat on the BCU1525s: brings the card (or both) up under the guard, chats (opentpu.host.chat --backend board,
# default --model qwen35-2b), and puts what it brought up back in SAFE when the chat ends. Which cards follows the
# image they hold:
#   a one-card image (bcu1525-wg): --card 0 (the default) or 1, BCU_ENV's cards (otpu-chat35's header); wg_bringup up:
#     the trips, the four DIMMs, the accelerator; RUN held
#   the two-card image (bcu1525-x2, both cards one machine over the QSFP28 link): both cards, no --card (or --card x2);
#     tools/x2_session/bringup.py up on each. A card of it cannot run alone: --card 0 or 1 is refused at once.
# A card in SAFE keeps its accelerator's registers fenced, so the image is not read from it: BCU_IMAGE (x2 or one, in
# the environment or BCU_ENV) says, else the marker $BCU_BUILD/cardimg/x2/IMAGE (there: x2), else one. The registers
# are asked only when they answer (a card left running), and then they decide.
# Options go to the chat (otpu-chat --help: its own).
#   otpu-chat                      # Qwen3.5-2B, the full-screen chat
#   otpu-chat --model gemma4       # Gemma 4 E2B (instruct)
#   otpu-chat --prompt "Hi"        # one question, plain output
#   otpu-chat --card 1             # the second card, a one-card image (its xdma device found by its PCI function)
#   otpu-chat --model qwen36-35b   # Qwen3.6-35B-A3B, its whole context: on both cards (otpu-chat35x2) when they hold the
#                                  # two-card image, else on one (otpu-chat35: --card's, default BCU_CARD's)
# BCU_TREE: the host tree (default $BCU_BUILD/bcu-wg/tree); BCU_X2_TARGET: the two-card image's target (default
# bcu1525-x2:st16); BCU_RESUME: the governor's RESUME for the bring-up (C, at most 69.9; unset: wg_bringup's 65).
set -u
_pre=(); for v in $(compgen -e | grep '^BCU_'); do _pre+=("$v=${!v}"); done
[ -f "${BCU_ENV:=$HOME/.config/otpu/bcu.env}" ] && . "$BCU_ENV"
for v in ${_pre[@]+"${_pre[@]}"}; do export "$v"; done        # (the environment's BCU_* win over the file's)
BB=${BCU_BUILD:-$HOME/otpu-build}; PY=${BCU_PY:-$(command -v python3)}
T=$BB/bcu-wg/tree
T=${BCU_TREE:-$T}; X2T=${BCU_X2_TARGET:-bcu1525-x2:st16}
RES=(); [ -z "${BCU_RESUME:-}" ] || { export BCU_RESUME; RES=(--resume "$BCU_RESUME"); }
m35=0; rest=(); cardarg=
while [ $# -gt 0 ]; do
  case $1 in
    --model) case ${2:-} in qwen36-35b|qwen36-35b-a3b|Qwen3.6-35B-A3B) m35=1; shift 2; continue ;; esac ;;
    --card) cardarg=${2:-}; [ $# -ge 2 ] && shift; shift; continue ;;
  esac
  rest+=("$1"); shift
done
# (${a[@]+...}: bash before 4.4 takes an empty array as unbound under set -u)
set -- ${rest[@]+"${rest[@]}"}
case ${cardarg:-0} in
  0|1|x2) ;;
  one) [ $m35 = 1 ] || { echo "otpu-chat: --card 0, 1 or x2"; exit 2; } ;;
  *) echo "otpu-chat: --card 0 or 1 (a one-card image), or x2 (the two-card image: both cards)"; exit 2 ;;
esac
img=${BCU_IMAGE:-}
[ -n "$img" ] || { img=one; [ -f "$BB/cardimg/x2/IMAGE" ] && img=x2; }
case $img in one|x2) ;; *) echo "otpu-chat: BCU_IMAGE is one or x2, not '$img'"; exit 2 ;; esac
# Qwen3.6-35B-A3B: otpu-chat35x2 (both cards, the two-card image) or otpu-chat35 (one card); the other options go to it
if [ $m35 = 1 ]; then
  card35=${cardarg:-$img}
  case $card35 in 0|1) export BCU_CARD=$card35 ;; esac
  [ "$card35" = x2 ] && exec "$BB/bin/otpu-chat35x2" "$@"
  exec "$BB/bin/otpu-chat35" "$@"
fi
case " $* " in *" -h "*|*" --help "*)
  cd "$T" && PYTHONPATH=. OTPU_TARGET=bcu1525-wg exec "$PY" -m opentpu.host.chat --help ;; esac
card() {        # card N: S, BDF, NAME and DEV (its XDMA device, by its PCI function) of card N, from BCU_CARDN_*
  local s=BCU_CARD${1}_SERIAL b=BCU_CARD${1}_BDF n=BCU_CARD${1}_NAME u
  S=${!s:-}; BDF=${!b:-}; NAME=${!n:-card$1}
  [ -n "$S" ] && [ -n "$BDF" ] || { echo "otpu-chat: $s and $b are not set (BCU_ENV: $BCU_ENV)"; exit 2; }
  u=$(ls /sys/bus/pci/devices/$BDF/xdma/ 2>/dev/null | grep "_user$" | head -1)
  [ -n "$u" ] || { echo "otpu-chat: no openTPU image on $NAME ($BDF)"; exit 1; }
  DEV=/dev/${u%_user}
}
cd "$T" || exit 2
export PYTHONPATH=.
first=0; [ "${cardarg:-0}" = 1 ] && first=1
card $first
# the card's own word, when its registers answer (not fenced: a card left running): x2, one or nothing
seen=$("$PY" - "$DEV" 2>/dev/null <<'PYEOF'
import sys
try:
    from opentpu.host.board import Board, XdmaTransport
    from opentpu.host import regs as R
    from opentpu.target import by_platform, cards
    t = XdmaTransport(sys.argv[1], dma=False)
    if t.reg_read(R.R_ID) == R.ID_OTPU:
        tg = by_platform(Board(t, check=False, lock=False).info()["cfg"]["platform"])
        if tg is not None:
            print("x2" if cards(tg) > 1 else "one")
except Exception:
    pass
PYEOF
)
[ -z "$seen" ] || img=$seen
two="the two-card image (bcu1525-x2: its slices run with the other card's, over the QSFP28 link)"
case $img:$cardarg in
  x2:0|x2:1) echo "otpu-chat: card $cardarg ($NAME) holds $two: it cannot chat alone."
             echo "  otpu-chat without --card runs on both cards; for --card $cardarg load a one-card image first"
             echo "  (wg_bringup.py load; BCU_IMAGE=one once it is loaded)"; exit 2 ;;
  one:x2) echo "otpu-chat: --card x2 needs the two-card image on both cards (BCU_IMAGE=x2 once it is loaded), and"
          echo "  $NAME holds a one-card image"; exit 2 ;;
esac
# "$PY" -c "$SETSID" CMD ARGS: CMD in a session of its own (no fork: $! stays its PID), out of the terminal's process
# group: neither its Ctrl-C nor its hangup reaches it
SETSID='import os, sys
try:
    os.setsid()
except OSError:                 # (a process group leader already: not in the foreground group)
    pass
os.execv(sys.argv[1], sys.argv[1:])'
# the die against the RESUME the bring-up sets, each card's governor: "NAME DEV" pairs as arguments
gov_check() {
  "$PY" - "$@" <<'PYEOF'
import os, sys
from opentpu.host.board import XdmaTransport
from opentpu.host import gov as G
r = float(os.environ.get("BCU_RESUME") or 65)      # (the RESUME the bring-up sets: wg_bringup's 65 without it)
for name, dev in zip(sys.argv[1::2], sys.argv[2::2]):
    g = G.Gov(XdmaTransport(dev, dma=False))
    if not g.present():
        raise SystemExit(f"otpu-chat: no governor on {name} ({dev}: is the BCU image loaded?)")
    t = g.status()["temp_c"]
    print(f"otpu-chat: {name} {dev} die {t:.1f} C")
    if t > r:
        print(f"otpu-chat: {name}: the die is above RESUME ({r:g} C): the bring-up waits for it to cool, 30 minutes "
              f"at most. If the fans hold it there (their target above RESUME), set BCU_RESUME (at most 69.9)")
PYEOF
}
safe_line() {    # safe_line NAME DIR, its bring-up exited: the governor's state after its SAFE (wg.json's status_safe)
  if "$PY" - "$2/wg.json" <<'PYEOF'
import json, sys
try:
    s = json.load(open(sys.argv[1])).get("status_safe") or {}
except (OSError, ValueError):
    s = {}
sys.exit(0 if s and not s.get("run") and not s.get("acc_on") else 1)
PYEOF
  then echo "otpu-chat: $1 back in SAFE ($2)"
  else echo "otpu-chat: $1's bring-up has ended, but $2/wg.json does not say SAFE: check the card (otpu-smi)"
  fi
}
waited=0
waiting() {     # waiting LOG...: every BCU_WAIT_SAY (15) s of the wait, each bring-up's latest "waiting for GO" line
  waited=$((waited + 1)); [ $((waited % ${BCU_WAIT_SAY:-15})) = 0 ] || return 0
  local f l
  for f in "$@"; do
    l=$(grep "waiting for GO" "$f" 2>/dev/null | tail -1)
    [ -z "$l" ] || echo "otpu-chat: $(basename "$f" .log): ${l#* }"
  done
}
failed() {      # failed NAME LOG: a bring-up that ended before its hold
  echo "otpu-chat: $1: the bring-up failed:"; tail -15 "$2"
  grep -qE "ConfigMismatch|not a build of|CFG_HASH" "$2" 2>/dev/null &&
    echo "otpu-chat: the card holds another image than BCU_IMAGE=$img says (one: a one-card image; x2: the two-card image)"
  exit 1
}
busy() {        # busy SERIAL DEV: a bring-up already on that card
  pgrep -af "[w]g_bringup.py up|[x]2_session/bringup.py" | grep -qE -- "--serial $1( |$)|--dev $2( |$)"
}
trap 'exit 129' HUP             # (a hangup: after the chat has ended, as Ctrl-C's exit)
case " $* " in *" --model "*) ;; *) set -- --model qwen35-2b "$@" ;; esac
# each bring-up in a session of its own: Ctrl-C in the chat must not end the hold under it, nor the terminal's hangup
# (ignoring SIGINT is not enough: wg_bringup installs its own handler); it ends on bye's TERM, after the chat
if [ $img = x2 ]; then          # ---- both cards, the two-card image
  card 0; S0=$S; N0=$NAME; d0=$DEV
  card 1; S1=$S; N1=$NAME; d1=$DEV
  if busy "$S0" "$d0" || busy "$S1" "$d1"; then
    echo "otpu-chat: another bring-up holds a card:"; pgrep -af "[w]g_bringup.py up|[x]2_session/bringup.py"; exit 1
  fi
  export OTPU_TARGET=$X2T
  out=$BB/bcu-wg/runs/chat-x2-$(date +%m%d-%H%M%S)
  mkdir -p "$out"
  gov_check "$N0" "$d0" "$N1" "$d1" || exit 1
  echo "otpu-chat: bringing both cards up, $N0 on $d0 and $N1 on $d1 (about a minute; logs $out/up-*.log)"
  up() {        # up NAME SERIAL DEV: one card's guarded bring-up, RUN held
    mkdir -p "$out/up-$1"
    ( exec "$PY" -c "$SETSID" "$PY" -u tools/x2_session/bringup.py --tree "$T" up --out "$out/up-$1" \
        --serial "$2" --dev "$3" --no-jtag --no-trips --mem none --no-selftest ${RES[@]+"${RES[@]}"} --hold 240 ) \
      > "$out/up-$1.log" 2>&1 &
  }
  up "$N0" "$S0" "$d0"; u0=$!
  up "$N1" "$S1" "$d1"; u1=$!
  bye() {
    local p
    for p in $u0 $u1; do kill -TERM "$p" 2>/dev/null; done
    for p in $u0 $u1; do wait "$p" 2>/dev/null; done
    safe_line "$N0" "$out/up-$N0"; safe_line "$N1" "$out/up-$N1"
  }
  trap bye EXIT
  until [ -f "$out/up-$N0/HOLDING" ] && [ -f "$out/up-$N1/HOLDING" ]; do
    kill -0 "$u0" 2>/dev/null || failed "$N0" "$out/up-$N0.log"
    kill -0 "$u1" 2>/dev/null || failed "$N1" "$out/up-$N1.log"
    sleep 1; waiting "$out/up-$N0.log" "$out/up-$N1.log"
  done
  echo "otpu-chat: both cards up (the first run of a model builds its image and programs: minutes)"
  "$PY" -m opentpu.host.chat --backend board --dev "$d0+$d1" "$@"
  exit
fi
# ---- one card, a one-card image
export OTPU_TARGET=bcu1525-wg
if busy "$S" "$DEV"; then echo "otpu-chat: another bring-up holds $NAME:"; pgrep -af "[w]g_bringup.py up"; exit 1; fi
out=$BB/bcu-wg/runs/chat-$(date +%m%d-%H%M%S)
mkdir -p "$out"
gov_check "$NAME" "$DEV" || exit 1
echo "otpu-chat: bringing $NAME up on $DEV (about a minute; log $out/up.log)"
( exec "$PY" -c "$SETSID" "$PY" -u boards/bcu1525/scripts/wg_bringup.py up --out "$out" --mem none \
    --serial $S --dev $DEV --no-selftest ${RES[@]+"${RES[@]}"} --hold 240 ) > "$out/up.log" 2>&1 &
up=$!
bye() { kill -TERM "$up" 2>/dev/null; wait "$up" 2>/dev/null; safe_line card "$out"; }
trap bye EXIT
until [ -f "$out/HOLDING" ]; do
  kill -0 "$up" 2>/dev/null || failed "$NAME" "$out/up.log"
  sleep 1; waiting "$out/up.log"
done
echo "otpu-chat: card up (the first run of a model builds its image and programs: minutes)"
"$PY" -m opentpu.host.chat --backend board --dev $DEV "$@"
