# The PCIe hard block's wrapper (LitePCIe S7PCIEPHY's IP), generated by tools/litepcie/gen_core.py
create_ip -vendor xilinx.com -name pcie_7x -module_name pcie_s7
set obj [get_ips pcie_s7]
set_property -dict [list \
CONFIG.Device_ID {5054} \
CONFIG.PCIe_Blk_Locn {X0Y0} \
CONFIG.Link_Speed {5.0_GT/s} \
CONFIG.Maximum_Link_Width {X8} \
CONFIG.Trgt_Link_Speed {4'h2} \
CONFIG.Ref_Clk_Freq {100_MHz} \
CONFIG.User_Clk_Freq {250} \
CONFIG.Interface_Width {128_bit} \
CONFIG.Max_Payload_Size {256_bytes} \
CONFIG.Buf_Opt_BMA {True} \
CONFIG.Trans_Buf_Pipeline {None} \
CONFIG.Bar0_Enabled {True} \
CONFIG.Bar0_Type {Memory} \
CONFIG.Bar0_64bit {False} \
CONFIG.Bar0_Prefetchable {False} \
CONFIG.Bar0_Scale {Megabytes} \
CONFIG.Bar0_Size {1} \
CONFIG.Legacy_Interrupt {None} \
CONFIG.IntX_Generation {False} \
CONFIG.MSI_64b {False} \
CONFIG.Multiple_Message_Capable {1_vector} \
CONFIG.Subsystem_Vendor_ID {10EE} \
CONFIG.Subsystem_ID {4C50} \
CONFIG.Revision_ID {02} \
CONFIG.Class_Code_Base {12} \
CONFIG.Class_Code_Sub {00} \
CONFIG.Class_Code_Interface {00} \
] $obj
