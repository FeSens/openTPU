# SQRL FK35 pins and configuration: the FK33's (boards/sqrl-fk33/constraints/fk33_pins.xdc; the FK33 and FK35 share
# the PCB).
# PCIe: reference clock (100 MHz) on GTY quad 225's REFCLK0, PERST#, CLKREQ#, the edge connector's lanes 0..7.
set_property PACKAGE_PIN AD9 [get_ports pcie_refclk_p]
set_property PACKAGE_PIN AD8 [get_ports pcie_refclk_n]
create_clock -period 10.000 -name pcie_refclk [get_ports pcie_refclk_p]
set_property -dict {PACKAGE_PIN BE24 IOSTANDARD LVCMOS18} [get_ports pcie_perst_n]
set_false_path -from [get_ports pcie_perst_n]
set_property -dict {PACKAGE_PIN BE25 IOSTANDARD LVCMOS18} [get_ports pcie_clkreq]
set_property PACKAGE_PIN AL2 [get_ports {pcie_mgt_rxp[0]}]
set_property PACKAGE_PIN AL1 [get_ports {pcie_mgt_rxn[0]}]
set_property PACKAGE_PIN Y5  [get_ports {pcie_mgt_txp[0]}]
set_property PACKAGE_PIN Y4  [get_ports {pcie_mgt_txn[0]}]
set_property PACKAGE_PIN AM4 [get_ports {pcie_mgt_rxp[1]}]
set_property PACKAGE_PIN AM3 [get_ports {pcie_mgt_rxn[1]}]
set_property PACKAGE_PIN AA7 [get_ports {pcie_mgt_txp[1]}]
set_property PACKAGE_PIN AA6 [get_ports {pcie_mgt_txn[1]}]
set_property PACKAGE_PIN AK4 [get_ports {pcie_mgt_rxp[2]}]
set_property PACKAGE_PIN AK3 [get_ports {pcie_mgt_rxn[2]}]
set_property PACKAGE_PIN AB5 [get_ports {pcie_mgt_txp[2]}]
set_property PACKAGE_PIN AB4 [get_ports {pcie_mgt_txn[2]}]
set_property PACKAGE_PIN AN2 [get_ports {pcie_mgt_rxp[3]}]
set_property PACKAGE_PIN AN1 [get_ports {pcie_mgt_rxn[3]}]
set_property PACKAGE_PIN AC7 [get_ports {pcie_mgt_txp[3]}]
set_property PACKAGE_PIN AC6 [get_ports {pcie_mgt_txn[3]}]
set_property PACKAGE_PIN AP4 [get_ports {pcie_mgt_rxp[4]}]
set_property PACKAGE_PIN AP3 [get_ports {pcie_mgt_rxn[4]}]
set_property PACKAGE_PIN AD5 [get_ports {pcie_mgt_txp[4]}]
set_property PACKAGE_PIN AD4 [get_ports {pcie_mgt_txn[4]}]
set_property PACKAGE_PIN AR2 [get_ports {pcie_mgt_rxp[5]}]
set_property PACKAGE_PIN AR1 [get_ports {pcie_mgt_rxn[5]}]
set_property PACKAGE_PIN AF5 [get_ports {pcie_mgt_txp[5]}]
set_property PACKAGE_PIN AF4 [get_ports {pcie_mgt_txn[5]}]
set_property PACKAGE_PIN AT4 [get_ports {pcie_mgt_rxp[6]}]
set_property PACKAGE_PIN AT3 [get_ports {pcie_mgt_rxn[6]}]
set_property PACKAGE_PIN AE7 [get_ports {pcie_mgt_txp[6]}]
set_property PACKAGE_PIN AE6 [get_ports {pcie_mgt_txn[6]}]
set_property PACKAGE_PIN AU2 [get_ports {pcie_mgt_rxp[7]}]
set_property PACKAGE_PIN AU1 [get_ports {pcie_mgt_rxn[7]}]
set_property PACKAGE_PIN AH5 [get_ports {pcie_mgt_txp[7]}]
set_property PACKAGE_PIN AH4 [get_ports {pcie_mgt_txn[7]}]
# LEDs: four green, one RGB
set_property -dict {PACKAGE_PIN BD25 IOSTANDARD LVCMOS18} [get_ports {led[0]}]
set_property -dict {PACKAGE_PIN BE26 IOSTANDARD LVCMOS18} [get_ports {led[1]}]
set_property -dict {PACKAGE_PIN BD23 IOSTANDARD LVCMOS18} [get_ports {led[2]}]
set_property -dict {PACKAGE_PIN BF26 IOSTANDARD LVCMOS18} [get_ports {led[3]}]
set_property -dict {PACKAGE_PIN BC25 IOSTANDARD LVCMOS18} [get_ports {led[4]}]
set_property -dict {PACKAGE_PIN BB26 IOSTANDARD LVCMOS18} [get_ports {led[5]}]
set_property -dict {PACKAGE_PIN BB25 IOSTANDARD LVCMOS18} [get_ports {led[6]}]
set_false_path -to [get_ports {led[*] pcie_clkreq}]
# configuration: the two MT25QU256 (SPI x8), as the card's other designs
set_property CONFIG_MODE SPIx8 [current_design]
set_property BITSTREAM.CONFIG.SPI_BUSWIDTH 8 [current_design]
set_property BITSTREAM.CONFIG.CONFIGRATE 127.5 [current_design]
set_property BITSTREAM.CONFIG.SPI_FALL_EDGE YES [current_design]
set_property BITSTREAM.CONFIG.SPI_32BIT_ADDR YES [current_design]
set_property BITSTREAM.GENERAL.COMPRESS TRUE [current_design]
set_property BITSTREAM.CONFIG.OVERTEMPSHUTDOWN ENABLE [current_design]
