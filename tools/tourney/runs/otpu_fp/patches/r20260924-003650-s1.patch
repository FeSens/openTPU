diff --git a/rtl/vpu/otpu_fp.sv b/rtl/vpu/otpu_fp.sv
index 12072f4..79fee9d 100644
--- a/rtl/vpu/otpu_fp.sv
+++ b/rtl/vpu/otpu_fp.sv
@@ -86,21 +86,23 @@ package otpu_fp;
 
   function automatic fmul_mid_t fp_mul_s1(input f32_t a_in, input f32_t b_in);
     fmul_mid_t m;
-    f32_t a, b;
-    a = ftz(a_in);
