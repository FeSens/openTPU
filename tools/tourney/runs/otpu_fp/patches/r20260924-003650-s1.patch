-    if (a[30:23] == 8'hFF || b[30:23] == 8'hFF) begin
+    m.s = a_in[31] ^ b_in[31];
+    if (ia || ib) begin
       m.sp = 1'b1;
-      m.sv = (is_nan(a) || is_nan(b) || a[30:0] == 0 || b[30:0] == 0) ? F_NAN
-             : {m.s, 8'hFF, 23'd0};
-    end else if (a[30:23] == 0 || b[30:23] == 0) begin
+      m.sv = (na || nb || za || zb) ? F_NAN : {m.s, 8'hFF, 23'd0};
+    end else if (za || zb) begin
       m.sp = 1'b1;
       m.sv = {m.s, 31'd0};
     end
-    m.p = {1'b1, a[22:0]} * {1'b1, b[22:0]};
-    m.e = 11'(a[30:23]) + 11'(b[30:23]) - 11'sd127;
+    m.p = {1'b1, a_in[22:0]} * {1'b1, b_in[22:0]};
+    m.e = 11'(a_in[30:23]) + 11'(b_in[30:23]) - 11'sd127;
     return m;
   endfunction
