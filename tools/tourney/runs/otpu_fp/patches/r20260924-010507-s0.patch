--- a/rtl/vpu/otpu_fp.sv
+++ b/rtl/vpu/otpu_fp.sv
@@ -172,8 +172,9 @@ package otpu_fp;
     logic               sp;
     logic [2:0]         sv;
     logic               s;
-    logic signed [9:0]  e;
