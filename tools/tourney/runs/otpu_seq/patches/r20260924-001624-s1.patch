+  // ---- footprint conflicts (otpu_pkg conflict()/conflict_dram(), with cheaper comparators)
+  // x < z (unsigned 32-bit) as the carry out of an 11-bit add over 3-bit digits: per digit g,
+  // eq_g propagates, lt_g generates (le_g = lt_g | eq_g). One LUT6 for S = eq_g and one for
+  // DI = le_g per 3 bits: 22 LUTs + 3 CARRY4 instead of 32 LUTs + 8 CARRY4.
+  function automatic logic lt32(input logic [31:0] x, input logic [31:0] z);
+    logic [32:0] xe, ze;
+    logic [10:0] lt, le;
+    logic [11:0] s;
+    xe = {1'b0, x}; ze = {1'b0, z};
+    for (int g = 0; g < 11; g++) begin
+      // explicit gates, not '<', so Yosys does not build 11 tiny carry chains
+      lt[g] = (~xe[3*g+2] & ze[3*g+2]) |
+              (~(xe[3*g+2] ^ ze[3*g+2]) & ((~xe[3*g+1] & ze[3*g+1]) |
+              (~(xe[3*g+1] ^ ze[3*g+1]) & (~xe[3*g] & ze[3*g]))));
+      le[g] = lt[g] | (xe[3*g +: 3] == ze[3*g +: 3]);
+    end
+    s = {1'b0, le} + {1'b0, lt};
+    return s[11];
+  endfunction
+
+  function automatic logic ov_s(input rng_t a, input rng_t b);
+    return a.v && b.v && a.sp == b.sp && lt32(a.lo, b.hi) && lt32(b.lo, a.hi);
+  endfunction
+
+  // {conflict(n, e), conflict_dram(n, e)}: each pair test once; the DRAM variant keeps the
+  // overlapping pairs in DRAM (a.sp == b.sp, so that is the package's v masking)
+  function automatic logic [1:0] conf2(input fp_t n, input fp_t e);
+    logic c, cd, o;
+    c = n.all || e.all; cd = c;
+    for (int i = 0; i < 2; i++) begin
+      for (int j = 0; j < 4; j++) begin
+        o = ov_s(n.wr[i], e.rd[j]);
+        c |= o; cd |= o && n.wr[i].sp == SP_DRAM;
+        o = ov_s(e.wr[i], n.rd[j]);
+        c |= o; cd |= o && e.wr[i].sp == SP_DRAM;
+      end
+      for (int j = 0; j < 2; j++) begin
+        o = ov_s(n.wr[i], e.wr[j]);
+        c |= o; cd |= o && n.wr[i].sp == SP_DRAM;
+      end
+    end
+    return {c, cd};
+  endfunction
