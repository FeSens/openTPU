     if (b_take && !b_we) bt_q[OW'(bt_h + bt_n)] <= b_tag;
@@ -354,7 +362,7 @@ module otpu_axi_dram #(
         if (a_take && !a_we) aon = aon + 1;
         if (a_out) begin
           ao_h <= ao_h + 1; aon = aon - 1;
