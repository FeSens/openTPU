       if (qa_push[c]) qam[QW'(qa_h[c] + qa_n[c])] <= qa_e[c];
@@ -189,7 +191,7 @@ module otpu_axi_dram #(
     assign ha[c] = qam[qa_h[c]];
     assign hw[c] = qwm[qw_h[c]];
     assign rb_head[c] = rbm[rb_h[c]];
