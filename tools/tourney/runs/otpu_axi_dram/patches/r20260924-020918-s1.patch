+  logic [AW_:0] ra_rd [2];
 
   // ------------------------------------------------------------------ queue and FIFO memories
   // (per channel; written in their own processes so they map to LUT RAM)
@@ -175,7 +177,7 @@ module otpu_axi_dram #(
     qa_t          qam [QD];
     qa_t          qwm [QD];
     logic [511:0] rbm [RD];
