+
+// N-cycle delay line whose last stage is a flip-flop with a synchronous reset: Yosys' xilinx_srl
+// only chains FFs without a reset (FDRE with R tied 0), so the output is an FDRE (303 ps clk->Q)
+// and not an SRL (1472 ps); otpu_delay's attributes land on the wire and are ignored. The first
+// N-1 stages may still become SRLs. The reset value only shows before a chunk has passed.
+module otpu_mxu_dly #(parameter int W = 32, parameter int N = 1) (
+  input  logic         clk,
+  input  logic         rst,
+  input  logic         en,
+  input  logic [W-1:0] d,
+  output logic [W-1:0] q
+);
+  if (N == 0) begin : g_wire
+    assign q = d;
+  end else begin : g_regs
+    logic [W-1:0] din, qr;                 // qr: the output stage (reset: never an SRL)
+    if (N == 1) begin : g_one
+      assign din = d;
+    end else begin : g_sh
+      logic [W-1:0] r [N - 1];
+      always_ff @(posedge clk) if (en) begin
+        r[0] <= d;
+        for (int k = 1; k < N - 1; k++) r[k] <= r[k-1];
+      end
+      assign din = r[N-2];
+    end
+    always_ff @(posedge clk)
+      if (rst) qr <= '0; else if (en) qr <= din;
+    assign q = qr;
+  end
+endmodule
