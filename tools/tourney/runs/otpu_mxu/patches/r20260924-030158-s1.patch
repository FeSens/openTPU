+  // S5, S6: int -> fp32 (magnitude + leading zeros | normalize). With SW <= 25 (D <= 512) the
+  // magnitude has at most 24 significant bits, so every value is an fp32 exactly: no rounding.
+  if (SW <= 25) begin : g_i2f
+    localparam int LZW = $clog2(MG);
+    typedef struct packed {
+      logic           z, s;
+      logic [MG-1:0]  mag;
+      logic [LZW-1:0] lz;
+    } xi_mid_t;
+    function automatic xi_mid_t xi_s1(input logic signed [SW-1:0] x);
+      xi_mid_t m;
+      m.z = (x == 0);
+      m.s = x[SW-1];
+      m.mag = x[SW-1] ? MG'(-x) : MG'(x);
+      m.lz = '0;
+      for (int b = 0; b < MG; b++) if (m.mag[b]) m.lz = LZW'(MG - 1 - b);
+      return m;
+    endfunction
+    function automatic f32_t xi_s2(input xi_mid_t m);
+      logic [MG-1:0] nrm;
+      logic [7:0]    e;
+      logic [22:0]   frac;
+      if (m.z) return F_ZERO;
+      nrm = m.mag << m.lz;                    // leading one at bit MG-1
+      e = 8'(127 + MG - 1) - 8'(m.lz);
+      frac = '0;
+      frac[22 -: MG-1] = nrm[MG-2:0];
+      return {m.s, e, frac};
+    endfunction
+    xi_mid_t im [MCOLS];
+    always_ff @(posedge clk) if (en_c)
+      for (int j = 0; j < MCOLS; j++) begin
+        im[j] <= xi_s1(s4[j]);
+        fi[j] <= xi_s2(im[j]);
+      end
