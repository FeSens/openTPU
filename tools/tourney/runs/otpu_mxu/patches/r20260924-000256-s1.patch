+// otpu_fmul with the significand product taken from the raw operands: no flush-to-zero in front
+// of the DSP. Exact: fp_mul_s2 reads m.p only when !m.sp, i.e. both exponents are in 1..254,
+// where ftz(x) == x.
+module otpu_mxu_fmul
+  import otpu_fp::*;
+#(parameter int LAT = 2) (
+  input  logic  clk,
+  input  logic  en,
+  input  f32_t  a,
+  input  f32_t  b,
+  output f32_t  y
+);
+  fmul_mid_t m;
+  f32_t r;
+  always_ff @(posedge clk) if (en) begin
+    fmul_mid_t t;
+    t = fp_mul_s1(a, b);
+    t.p = {1'b1, a[22:0]} * {1'b1, b[22:0]};
+    m <= t;
+    r <= fp_mul_s2(m);
+  end
+  otpu_delay #(.W(32), .N(LAT - 2)) u_pad (.clk, .en, .d(r), .q(y));
+endmodule
+
+// otpu_fmadd on otpu_mxu_fmul: y = (a * b) + c, LAT = LM + LA
+module otpu_mxu_fmadd
+  import otpu_fp::*;
+#(parameter int LM = 2, parameter int LA = 4) (
+  input  logic  clk,
+  input  logic  en,
+  input  f32_t  a,
+  input  f32_t  b,
+  input  f32_t  c,
+  output f32_t  y
+);
+  f32_t p, cd;
+  otpu_mxu_fmul #(.LAT(LM)) u_m (.clk, .en, .a, .b, .y(p));
+  otpu_delay #(.W(32), .N(LM)) u_c (.clk, .en, .d(c), .q(cd));
+  otpu_fadd #(.LAT(LA)) u_a (.clk, .en, .a(p), .b(cd), .y);
+endmodule
