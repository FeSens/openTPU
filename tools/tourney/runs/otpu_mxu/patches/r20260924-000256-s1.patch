+// otpu_delay whose last stage has a synchronous reset: a reset flop cannot be packed into the
+// SRL, so the line's output comes from a real flip-flop (the lines feed multipliers and adders).
+// Only pipeline contents pass through: a reset clears bubbles.
+module otpu_mxu_dly #(parameter int W = 32, parameter int N = 1) (
+  input  logic         clk,
+  input  logic         rst,
+  input  logic         en,
+  input  logic [W-1:0] d,
+  output logic [W-1:0] q
+);
+  if (N == 0) begin : g_wire
+    assign q = d;
+  end else if (N == 1) begin : g_one
+    (* shreg_extract = "no", keep *) logic [W-1:0] qr;
+    always_ff @(posedge clk)
+      if (rst) qr <= '0;
+      else if (en) qr <= d;
+    assign q = qr;
+  end else begin : g_regs
+    logic [W-1:0] r [N - 1];
+    (* shreg_extract = "no", keep *) logic [W-1:0] qr;
+    always_ff @(posedge clk) if (en) begin
+      r[0] <= d;
+      for (int k = 1; k < N - 1; k++) r[k] <= r[k-1];
+    end
+    always_ff @(posedge clk)
+      if (rst) qr <= '0;
+      else if (en) qr <= r[N-2];
+    assign q = qr;
+  end
+endmodule
