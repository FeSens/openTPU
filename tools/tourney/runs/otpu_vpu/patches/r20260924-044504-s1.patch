+          otpu_fadd #(.LAT(LA)) u_add (.clk, .en, .a(oa), .b(ob), .y(xs[k]));
+          assign xl[q][k] = xs[k];
+        end else begin : g_add
+          otpu_fadd #(.LAT(LA)) u_add (.clk, .en, .a(xl[q-1][k]), .b(xl[q-1][k + (LANES >> q)]),
+                                       .y(xl[q][k]));
+        end
       end
     end
   end
