+    assign ln_l2  = 1'b0;
+    assign ln_l3  = 1'b0;
+    for (genvar q = 1; q <= LW; q++) begin : g_xl
+      for (genvar k = 0; k < (LANES >> q); k++) begin : g_k
+        if (SH2 && q == 2) begin : g_sh
+          assign xl[q][k] = xs[k];
+        end else if (SH2 && q == 1 && k < (LANES >> 2)) begin : g_mux
