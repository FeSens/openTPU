+  logic [LANES-1:0][31:0] xa, yb;
   always_ff @(posedge clk)
     if (rst) m0 <= '0;
     else if (en) begin
       m0 <= mi;
       xa <= ta_data;
-      xb <= tb_data;
+      for (int l = 0; l < LANES; l++)
+        yb[l] <= (mi.bmode == B_SCALAR) ? mi.imm : (mi.bmode == B_ROW) ? tb_data[0] : tb_data[l];
     end
 
   // the parts of the meta the later stages read: along the lane taps, and for the reductions
@@ -246,17 +248,19 @@ module otpu_vpu
   end
 
