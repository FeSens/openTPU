@@ -829,5 +827,9 @@ module otpu_vpu
   always_ff @(posedge clk)
     if (!rst && en && SH2 && l2_v && rsr[DL + LA - 1])
       $fatal(1, "otpu_vpu: RSUM/RSSQ lane level schedule collision");
+  // the long lanes' result muxes have fixed taps: every elementwise function must end at one
+  always_ff @(posedge clk)
+    if (!rst && en && mo.v && !(n_slots(mo.func) inside {4'd0, 4'd1, 4'd6, 4'd9, 4'd10}))
+      $fatal(1, "otpu_vpu: elementwise function ends at a tap without a result mux");
 `endif
 endmodule
